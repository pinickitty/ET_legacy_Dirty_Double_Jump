[Unit]
Description=ET server on port %i
CollectMode=inactive-or-failed

[Service]
SendSIGHUP=true
LogNamespace=%i
User=etsrv
WorkingDirectory=/home/%i

ExecStartPre=-!journalctl --namespace %i --vacuum-files 1 --rotate
ExecStart=bash cmd
ExecStartPost=!iptables -I OUTPUT -p udp --sport %i -m u32 ! --u32 "0x1c=0xffffffff" -m recent --rdest --name etk --set
ExecStartPost=!iptables -I INPUT -p udp --dport %i -j omg

ExecStop=etexit %i
ExecStopPost=!iptables -D INPUT -p udp --dport %i -j omg
ExecStopPost=!iptables -D OUTPUT -p udp --sport %i -m u32 ! --u32 "0x1c=0xffffffff" -m recent --rdest --name etk --set
